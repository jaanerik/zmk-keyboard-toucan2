#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define ADJ   3
#define MOU   4
#define L_WIN 5   // NAV+A held: Amethyst windows on this screen
#define L_SPC 6   // NAV+S held: spaces and screens
#define L_TRM 7   // NAV+D held: iTerm panes
#define L_TAB 8   // NAV+F held: tabs and apps

// Amethyst mod1 = Option+Shift, mod2 = Control+Option+Shift
#define AM1(k) LA(LS(k))
#define AM2(k) LC(LA(LS(k)))

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB       &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &mt LCTRL ESC &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT     &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                    &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB   &kp N1         &kp N2      &kp N3    &kp N4    &kp N5   &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &trans    &mo L_WIN      &mo L_SPC   &mo L_TRM &mo L_TAB &trans   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT &studio_unlock &bootloader &trans    &trans    &trans   &trans   &trans   &trans &trans    &trans &trans
                                             &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &trans       &trans       &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bootloader
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans       &trans       &trans       &trans       &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        // NAV+A: J/K focus prev/next window, U/I move window prev/next, H/L shrink/grow main pane,
        //        M focus main, Enter swap with main, Space cycle layout, Alt-thumb toggle float
        win {
            display-name = "WIN";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans     &kp AM2(J) &kp AM2(K) &trans     &trans &trans
                &trans &trans &trans &trans &trans &trans   &kp AM1(H) &kp AM1(J) &kp AM1(K) &kp AM1(L) &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans     &kp AM1(M) &trans     &trans     &trans &trans
                                  &trans &trans &kp AM1(SPACE)   &kp AM1(RET) &trans &kp AM1(T)
            >;
        };

        // NAV+S: H/L previous/next space, J/K throw window to space left/right,
        //        digits throw window to space N, N/. focus screen prev/next, M/, move window to screen prev/next
        spaces {
            display-name = "SPC";
            bindings = <
                &trans &kp AM2(N1) &kp AM2(N2) &kp AM2(N3) &kp AM2(N4) &kp AM2(N5)   &kp AM2(N6)  &kp AM2(N7)    &kp AM2(N8)     &kp AM2(N9)   &kp AM2(N0) &trans
                &trans &trans      &trans      &trans      &trans      &trans        &kp LC(LEFT) &kp AM2(LEFT)  &kp AM2(RIGHT)  &kp LC(RIGHT) &trans      &trans
                &trans &trans      &trans      &trans      &trans      &trans        &kp AM1(P)   &kp AM2(H)     &kp AM2(L)      &kp AM1(N)    &trans      &trans
                                                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        // NAV+D (iTerm): H/J/K/L select pane left/down/up/right, U/I split vertical/horizontal,
        //        N/M previous/next tab, Enter maximize pane, Alt-thumb fullscreen
        term {
            display-name = "TRM";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans           &kp LG(D)        &kp LG(LS(D))  &trans            &trans &trans
                &trans &trans &trans &trans &trans &trans   &kp LG(LA(LEFT)) &kp LG(LA(DOWN)) &kp LG(LA(UP)) &kp LG(LA(RIGHT)) &trans &trans
                &trans &trans &trans &trans &trans &trans   &kp LG(LS(LBKT)) &kp LG(LS(RBKT)) &trans         &trans            &trans &trans
                                           &trans &trans &trans   &kp LG(LS(RET)) &trans &kp LG(RET)
            >;
        };

        // NAV+F: H/L previous/next tab, J/K previous/next window of this app, digits tab N, Enter last app
        tabs {
            display-name = "TAB";
            bindings = <
                &trans &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)   &kp LG(N6)      &kp LG(N7)         &kp LG(N8)    &kp LG(N9)  &trans &trans
                &trans &trans     &trans     &trans     &trans     &trans       &kp LC(LS(TAB)) &kp LG(LS(GRAVE))  &kp LG(GRAVE) &kp LC(TAB) &trans &trans
                &trans &trans     &trans     &trans     &trans     &trans       &trans          &trans             &trans        &trans      &trans &trans
                                                  &trans &trans &trans   &kp LG(TAB) &trans &trans
            >;
        };

        extra_9 {
            status = "reserved";
        };

        extra_10 {
            status = "reserved";
        };
    };
};
