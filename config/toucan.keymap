#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define ADJ   3
#define MOU   4
#define L_WIN 5   // NAV+A held: Amethyst windows on this screen
#define L_SPC 6   // NAV+S held: spaces and screens
#define L_TRM 7   // NAV+D held: iTerm panes
#define L_TAB 8   // NAV+F held: tabs and apps

// Amethyst mod1 = Option+Shift, mod2 = Control+Option+Shift
#define AM1(k) LA(LS(k))
#define AM2(k) LC(LA(LS(k)))

/ {
    // Right Option dead keys on the macOS ABC layout (iTerm passes right Option through).
    macros {
        m_ae: m_ae { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(U) &kp A>; };
        m_ae_cap: m_ae_cap { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(U) &kp LS(A)>; };
        m_ue: m_ue { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(U) &kp U>; };
        m_ue_cap: m_ue_cap { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(U) &kp LS(U)>; };
        m_oe: m_oe { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(U) &kp O>; };
        m_oe_cap: m_oe_cap { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(U) &kp LS(O)>; };
        m_ot: m_ot { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(N) &kp O>; };
        m_ot_cap: m_ot_cap { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(N) &kp LS(O)>; };
    };

    // Shift picks the capital variant.
    behaviors {
        ae: ae { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&m_ae>, <&m_ae_cap>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        ue: ue { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&m_ue>, <&m_ue_cap>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        oe: oe { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&m_oe>, <&m_oe_cap>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        ot: ot { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&m_ot>, <&m_ot_cap>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        // Option (right thumb) + vowel types the Estonian letter; other Option chords pass through.
        alt_a: alt_a { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp A>, <&ae>; mods = <(MOD_LALT|MOD_RALT)>; };
        alt_u: alt_u { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp U>, <&ue>; mods = <(MOD_LALT|MOD_RALT)>; };
        alt_i: alt_i { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp I>, <&ot>; mods = <(MOD_LALT|MOD_RALT)>; };
        alt_o: alt_o { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp O>, <&oe>; mods = <(MOD_LALT|MOD_RALT)>; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB       &kp Q  &kp W &kp E &kp R &kp T   &kp Y &alt_u &alt_i    &alt_o  &kp P    &kp BSPC
                &mt LCTRL ESC &alt_a &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT     &kp Z  &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                    &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB   &kp N1         &kp N2      &kp N3    &kp N4    &kp N5     &kp N6   &kp N7    &kp N8   &kp N9    &kp N0 &kp DEL
                &trans    &mo L_WIN      &mo L_SPC   &mo L_TRM &mo L_TAB &kp GLOBE  &kp LEFT &kp DOWN  &kp UP   &kp RIGHT &trans &trans
                &kp LSHFT &studio_unlock &bootloader &trans    &trans    &trans     &kp HOME &kp PG_DN &kp PG_UP &kp END  &trans &trans
                                             &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bootloader
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &kp C_PREV   &kp C_PP     &kp C_NEXT   &trans       &trans       &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        // NAV+A: J/K focus prev/next window, U/I move window prev/next, H/L shrink/grow main pane,
        //        M focus main, Enter swap with main, Space cycle layout, Alt-thumb toggle float
        win {
            display-name = "WIN";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans     &kp AM2(J) &kp AM2(K) &trans     &trans &trans
                &trans &trans &trans &trans &trans &trans   &kp AM1(H) &kp AM1(J) &kp AM1(K) &kp AM1(L) &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans     &kp AM1(M) &trans     &trans     &trans &trans
                                  &trans &trans &kp AM1(SPACE)   &kp AM1(RET) &trans &kp AM1(T)
            >;
        };

        // NAV+S: J/K previous/next space, H/L throw window to space left/right,
        //        U..BSPC go to space 1-5, M/, focus previous/next screen, N/. throw window to previous/next screen,
        //        right thumbs Mission Control / App Expose
        spaces {
            display-name = "SPC";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans        &kp LC(N1)   &kp LC(N2)    &kp LC(N3)     &kp LC(N4) &kp LC(N5)
                &trans &trans &trans &trans &trans &trans   &kp AM2(LEFT) &kp LC(LEFT) &kp LC(RIGHT) &kp AM2(RIGHT) &trans     &trans
                &trans &trans &trans &trans &trans &trans   &kp AM2(H)    &kp AM1(P)   &kp AM1(N)    &kp AM2(L)     &trans     &trans
                                            &trans &trans &trans   &kp LC(UP) &trans &kp LC(DOWN)
            >;
        };

        // NAV+D (iTerm): H/J/K/L select pane left/down/up/right, U/I split vertical/horizontal,
        //        N/M previous/next tab, Enter maximize pane, Alt-thumb fullscreen
        term {
            display-name = "TRM";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans           &kp LG(D)        &kp LG(LS(D))  &trans            &trans &trans
                &trans &trans &trans &trans &trans &trans   &kp LG(LA(LEFT)) &kp LG(LA(DOWN)) &kp LG(LA(UP)) &kp LG(LA(RIGHT)) &trans &trans
                &trans &trans &trans &trans &trans &trans   &kp LG(LS(LBKT)) &kp LG(LS(RBKT)) &trans         &trans            &trans &trans
                                           &trans &trans &trans   &kp LG(LS(RET)) &trans &kp LG(RET)
            >;
        };

        // NAV+F: H/L previous/next tab, J/K previous/next window of this app, digits tab N, Enter last app
        tabs {
            display-name = "TAB";
            bindings = <
                &trans &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)   &kp LG(N6)      &kp LG(N7)         &kp LG(N8)    &kp LG(N9)  &trans &trans
                &trans &trans     &trans     &trans     &trans     &trans       &kp LC(LS(TAB)) &kp LG(LS(GRAVE))  &kp LG(GRAVE) &kp LC(TAB) &trans &trans
                &trans &trans     &trans     &trans     &trans     &trans       &trans          &trans             &trans        &trans      &trans &trans
                                                  &trans &trans &trans   &kp LG(TAB) &trans &trans
            >;
        };

        extra_9 {
            status = "reserved";
        };

        extra_10 {
            status = "reserved";
        };
    };
};
